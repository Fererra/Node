{
  "name": "cinema-booking-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for booking cinema tickets",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deps:check && npm run test:unit && npm run test:coverage && npm run build",
    "check:fast": "npm run typecheck && npm run deps:check && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "deps:check": "depcruise src --config .dependency-cruiser.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "husky",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/app/cli/migrate.js",
    "db:seed": "npm run build && node --env-file-if-exists=.env dist/app/cli/seed.js",
    "test:func": "vitest run --config vitest.func.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "node scripts/test-all.mjs",
    "mutation": "stryker run"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "*.{ts,mts,cts,js,mjs,cjs}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  }
}
