{
  "name": "cinema-booking-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for booking cinema tickets",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
